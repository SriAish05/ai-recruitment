# Copy to .env and fill in real values before running docker-compose

# MySQL
MYSQL_ROOT_PASSWORD=changeme
DB_USERNAME=root
DB_PASSWORD=changeme

# Spring Boot JWT (min 64 chars)
JWT_SECRET=your-64-char-secret-here-replace-this-with-something-random-and-long

# Google Gemini
GOOGLE_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-2.0-flash

# SMTP (only needed in prod profile)
SMTP_USERNAME=placeholder
SMTP_PASSWORD=placeholder
