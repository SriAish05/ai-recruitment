spring:
  datasource:
    url: jdbc:mysql://localhost:3306/recruitdb?useSSL=false&serverTimezone=UTC
    username: root
    password: your_mysql_password_here
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect

  # Email — use Mailtrap (https://mailtrap.io) for dev, never a real SMTP server
  mail:
    host: sandbox.smtp.mailtrap.io
    port: 2525
    username: your_mailtrap_username
    password: your_mailtrap_password
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

# JWT configuration
jwt:
  secret: REPLACE_THIS_WITH_A_REAL_SECRET_AT_LEAST_64_CHARACTERS_LONG_USE_openssl_rand_base64_64
  expiration-ms: 86400000  # 24 hours

# AI service endpoint (Spring Boot calls this, never the frontend)
app:
  aiservice:
    url: http://localhost:8000
